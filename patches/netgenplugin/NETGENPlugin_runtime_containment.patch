+  //================================================================================
+  /*!
+   * \brief pySMESH: a stream that writes nowhere (no buffer), for netgen's messages
+   */
+  //================================================================================
+
+  std::ostream& silentStream()
+  {
+    static std::ostream stream( nullptr );
+    return stream;
+  }
+
+  //================================================================================
+  /*!
+   * \brief pySMESH: the parts of SMESH_File's text cursor that ReadErrors uses, over a
+   *        string in memory instead of a mapped file, with the same semantics
+   */
+  //================================================================================
+
+  class TextCursor
+  {
+  public:
+    explicit TextCursor( const std::string& text )
+      : _begin( text.c_str() ), _pos( text.c_str() ), _end( text.c_str() + text.size() ) {}
+    operator const char*() const { return _pos; }
+    TextCursor& operator++() { ++_pos; return *this; }
+    TextCursor& operator+=( int n ) { _pos += n; return *this; }
+    bool eof() const { return _pos >= _end; }
+    void setPos( const char* pos ) { if ( pos > _begin && pos < _end ) _pos = pos; }
+    // skip till the current line end
+    void getLine()
+    {
+      while ( !eof() )
+        if ( *(++_pos) == '\n' )
+          break;
+      if ( !eof() ) ++_pos;
+    }
+    // read ints.size() integers, skipping what is not a digit before each
+    bool getInts( std::vector<int>& ints )
+    {
+      size_t i = 0;
+      while ( i < ints.size() )
+      {
+        while ( !eof() && !isdigit( (unsigned char) *_pos )) ++_pos;
+        if ( eof() ) break;
+        if ( _pos > _begin && _pos[-1] == '-' ) --_pos;
+        char* next = 0;
+        ints[ i++ ] = (int) strtol( _pos, &next, 10 );
+        _pos = next;
+      }
+      return ( i == ints.size() );
+    }
+  private:
+    const char* _begin;
+    const char* _pos;
+    const char* _end;
+  };
+
   inline void NOOP_Deleter(void *) { ; }
 
