+   * LProp_NotDefined where the curvature is not defined, as OCCT 7's MaxCurvature() did.
+   */
+  //================================================================================
+
+  double maxCurvatureMagnitude( BRepLProp_SLProps& surfProp )
+  {
+    if ( !surfProp.IsCurvatureDefined() )
+      throw LProp_NotDefined();
+    return Max( Abs( surfProp.MaxCurvature()), Abs( surfProp.MinCurvature() ));
   }
 
