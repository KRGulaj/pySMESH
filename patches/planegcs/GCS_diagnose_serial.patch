+++ b/Mod/Sketcher/App/planegcs/GCS.cpp
@@ -4901,6 +4901,7 @@ int System::diagnose(Algorithm alg)
         // identifyDependentParametersDenseQR(J, jacobianconstraintmap, pdiagnoselist, true)
         //
         auto fut = std::async(
+            std::launch::deferred,
