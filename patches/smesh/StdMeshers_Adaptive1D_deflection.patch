+  //================================================================================
+  /*!
+   * \brief pySMESH: sagitta of a segment of a curve. It is the largest distance from
+   *        the curve, between the two end parameters, to the chord: 16 samples, then
+   *        a golden-section search between the two samples next to the largest one.
+   */
+  //================================================================================
+
+  double segmentSagitta( const BRepAdaptor_Curve& theCurve,
+                         const double             theU1,
+                         const double             theU2 )
+  {
+    const gp_XYZ p1    = theCurve.Value( theU1 ).XYZ();
+    const gp_XYZ chord = theCurve.Value( theU2 ).XYZ() - p1;
+    const double len2  = chord.SquareModulus();
+    auto distToChord = [&]( const double u ) -> double
+    {
+      const gp_XYZ v = theCurve.Value( u ).XYZ() - p1;
+      const double t = len2 > 0. ? Max( 0., Min( 1., ( v * chord ) / len2 )) : 0.;
+      return ( v - chord * t ).Modulus();
+    };
+    const int    nbSamples = 16;
+    const double du        = ( theU2 - theU1 ) / nbSamples;
+    double maxDist = 0.;
+    int    iMax    = 1;
+    for ( int i = 1; i < nbSamples; ++i )
+    {
+      const double d = distToChord( theU1 + i * du );
+      if ( d > maxDist )
+      {
+        maxDist = d;
+        iMax    = i;
+      }
+    }
+    const double golden = 0.5 * ( sqrt( 5. ) - 1. );
+    double a = theU1 + ( iMax - 1 ) * du, b = theU1 + ( iMax + 1 ) * du;
+    double c = b - golden * ( b - a ),    d = a + golden * ( b - a );
+    double fc = distToChord( c ),         fd = distToChord( d );
+    const double uTol = 1e-12 * Abs( theU2 - theU1 );
+    for ( int it = 0; it < 200 && b - a > uTol; ++it )
+    {
+      if ( fc > fd )
+      {
+        b = d; d = c; fd = fc;
+        c = b - golden * ( b - a );
+        fc = distToChord( c );
+      }
+      else
+      {
+        a = c; c = d; fc = fd;
+        d = a + golden * ( b - a );
+        fd = distToChord( d );
+      }
+    }
+    return Max( maxDist, Max( fc, fd ));
+  }
+
+  //================================================================================
+  /*!
+   * \brief pySMESH: size field of one EDGE on a uniform parameter grid
+   */
+  //================================================================================
+
+  struct EdgeGrid
+  {
+    vector< double > myU;  // grid parameters, from first to last, uniform
+    vector< double > myDs; // chord length of each grid step, myDs[0] = 0
+    vector< double > myH;  // graded segment size at each grid point
+    vector< double > myF;  // size of the final distribution at each grid point
+
+    // index i of the grid step [ i-1, i ] that holds the parameter u
+    size_t Step( const double u ) const
+    {
+      const size_t nbSteps = myU.size() - 1;
+      const double r = ( u - myU[0] ) / ( myU[ nbSteps ] - myU[0] ) * double( nbSteps );
+      const size_t i = r <= 1. ? 1 : size_t( ceil( r ));
+      return i > nbSteps ? nbSteps : i;
+    }
+    // value of a grid array at the parameter u, interpolated linearly
+    double At( const vector< double >& values, const double u ) const
+    {
+      const size_t i = Step( u );
+      const double r = ( u - myU[i-1] ) / ( myU[i] - myU[i-1] );
+      return values[i-1] + r * ( values[i] - values[i-1] );
+    }
+    // largest value of a grid array on [ u1, u2 ]: at both ends and at the grid points
+    // strictly between them
+    double SpanMax( const vector< double >& values, const double u1, const double u2 ) const
+    {
+      double maxValue = Max( At( values, u1 ), At( values, u2 ));
+      const size_t iEnd = Step( u2 );
+      for ( size_t i = Step( u1 ); i < iEnd; ++i )
+        if ( myU[i] > u1 )
+          maxValue = Max( maxValue, values[i] );
+      return maxValue;
+    }
+  };
 
