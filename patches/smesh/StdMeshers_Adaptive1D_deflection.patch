 //================================================================================
 /*!
+ * \brief pySMESH: largest size of the field of makeSegments() on [u1, u2]: the probe
+ *        sizes interpolated in parameter and limited by the size tree, at the two
+ *        ends and 15 points between them
+ */
+//================================================================================
+
+double AdaptiveAlgo::probeFieldMax( const EdgeData& eData, double u1, double u2 ) const
+{
+  const double maxSize = myHyp->GetMaxSize();
+  double fieldMax = 0.;
+  list< EdgeData::ProbePnt >::const_iterator p2 = eData.myPoints.begin(), p1 = p2++;
+  const int nbSamples = 16;
+  for ( int i = 0; i <= nbSamples; ++i )
+  {
+    const double u = u1 + ( u2 - u1 ) * i / nbSamples;
+    while ( p2 != eData.myPoints.end() && p2->myU < u )
+      ++p1, ++p2;
+    double size = Min( p1->mySegSize, maxSize );
+    if ( p2 != eData.myPoints.end() && p2->myU > p1->myU )
+    {
+      const double r = Max( 0., ( u - p1->myU ) / ( p2->myU - p1->myU ));
+      size = ( 1 - r ) * size + r * Min( p2->mySegSize, maxSize );
+    }
+    size = Min( size, mySizeTree->GetSize( eData.myC3d.Value( u )));
+    fieldMax = Max( fieldMax, size );
+  }
+  return fieldMax;
+}
+
+//================================================================================
+/*!
+ * \brief pySMESH: limit the probe sizes of an EDGE to a size all over [u1, u2]
+ */
+//================================================================================
+
+void AdaptiveAlgo::lowerProbeSize( EdgeData& eData, double u1, double u2, double size ) const
+{
+  EdgeData::TPntIter p = eData.myPoints.begin();
+  for ( ; p != eData.myPoints.end(); ++p )
+    if ( u1 <= p->myU && p->myU <= u2 )
+      p->mySegSize = Min( p->mySegSize, size );
+
+  // probe points at both ends and the middle, so that the interpolated size is at
+  // most the given one all over [u1, u2]
+  const double us[3] = { u1, 0.5 * ( u1 + u2 ), u2 };
+  for ( int i = 0; i < 3; ++i )
+  {
+    EdgeData::TPntIter p2 = eData.myPoints.begin();
+    while ( p2 != eData.myPoints.end() && p2->myU < us[i] )
+      ++p2;
+    if ( p2 != eData.myPoints.end() && p2->myU == us[i] )
+    {
+      p2->mySegSize = Min( p2->mySegSize, size );
+      continue;
+    }
+    double sizeHere = size;
+    if ( p2 != eData.myPoints.end() && p2 != eData.myPoints.begin() )
+    {
+      EdgeData::TPntIter p1 = p2;
+      --p1;
+      const double r = ( us[i] - p1->myU ) / ( p2->myU - p1->myU );
+      sizeHere = Min( size, ( 1 - r ) * p1->mySegSize + r * p2->mySegSize );
+    }
+    eData.myPoints.insert( p2, EdgeData::ProbePnt( eData.myC3d.Value( us[i] ), us[i], sizeHere ));
+  }
+}
+
+//================================================================================
+/*!
+ * \brief pySMESH: sample the size field of an EDGE on a uniform parameter grid and
+ *        grade it. The size is the probe sizes interpolated in parameter, limited by
+ *        the size tree and kept within [floorSize, maxSize], as makeSegments() reads
+ *        it. Grading: a size grows by at most theGrading times the distance, so that
+ *        two adjacent segments differ by at most exp( theGrading ) < 2.
+ */
+//================================================================================
+
+void AdaptiveAlgo::buildGrid( const EdgeData& eData, double floorSize, bool isClosed,
+                              EdgeGrid& grid ) const
+{
+  const double theGrading  = 0.5;
+  const double theSubSteps = 10;     // grid steps per segment, at least
+  const size_t theMaxSteps = 1000000;
+  const double maxSize = myHyp->GetMaxSize();
+  const double f = eData.myC3d.FirstParameter(), l = eData.myC3d.LastParameter();
+
+  double sizeMin = maxSize;
+  list< EdgeData::ProbePnt >::const_iterator p = eData.myPoints.begin();
+  for ( ; p != eData.myPoints.end(); ++p )
+    sizeMin = Min( sizeMin, p->mySegSize );
+  sizeMin = Max( sizeMin, floorSize );
+  const double nbStart = Max( 16., ceil( theSubSteps * eData.myLength / sizeMin ));
+  size_t nbSteps = size_t( Min( nbStart, double( theMaxSteps )));
+
+  while ( true )
+  {
+    grid.myU.resize( nbSteps + 1 );
+    grid.myDs.resize( nbSteps + 1 );
+    grid.myH.resize( nbSteps + 1 );
+    list< EdgeData::ProbePnt >::const_iterator p2 = eData.myPoints.begin(), p1 = p2++;
+    gp_Pnt pPrev;
+    for ( size_t i = 0; i <= nbSteps; ++i )
+    {
+      const double u = ( i == nbSteps ) ? l : f + ( l - f ) * double( i ) / double( nbSteps );
+      while ( p2 != eData.myPoints.end() && p2->myU < u )
+        ++p1, ++p2;
+      double size = Min( p1->mySegSize, maxSize );
+      if ( p2 != eData.myPoints.end() && p2->myU > p1->myU )
+      {
+        const double r = Max( 0., ( u - p1->myU ) / ( p2->myU - p1->myU ));
+        size = ( 1 - r ) * size + r * Min( p2->mySegSize, maxSize );
+      }
+      const gp_Pnt pu = eData.myC3d.Value( u );
+      size = Min( size, mySizeTree->GetSize( pu ));
+      grid.myU [i] = u;
+      grid.myDs[i] = ( i == 0 ) ? 0. : pu.Distance( pPrev );
+      grid.myH [i] = Min( maxSize, Max( floorSize, size ));
+      pPrev = pu;
+    }
+    // grading, both ways; twice round a closed EDGE, whose ends are one point
+    vector< double >& h = grid.myH;
+    for ( int iRound = 0; iRound < ( isClosed ? 2 : 1 ); ++iRound )
+    {
+      if ( isClosed )
+        h[0] = h[ nbSteps ] = Min( h[0], h[ nbSteps ]);
+      for ( size_t i = 1; i <= nbSteps; ++i )
+        h[i] = Min( h[i], h[i-1] + theGrading * grid.myDs[i] );
+      if ( isClosed )
+        h[0] = h[ nbSteps ] = Min( h[0], h[ nbSteps ]);
+      for ( size_t i = nbSteps; i > 0; --i )
+        h[i-1] = Min( h[i-1], h[i] + theGrading * grid.myDs[i] );
+    }
+    // refine the grid until every step is at most 1/theSubSteps of its sizes
+    double maxStepRatio = 0.;
+    for ( size_t i = 1; i <= nbSteps; ++i )
+      maxStepRatio = Max( maxStepRatio, grid.myDs[i] / Min( h[i-1], h[i] ));
+    if ( maxStepRatio * theSubSteps <= 1. + 1e-9 || 2 * nbSteps > theMaxSteps )
+      break;
+    nbSteps = size_t( ceil( nbSteps * maxStepRatio * theSubSteps ));
+    if ( nbSteps > theMaxSteps )
+      nbSteps = theMaxSteps;
+  }
+}
+
+//================================================================================
+/*!
+ * \brief pySMESH: place the nodes of an EDGE on the graded size field of a grid.
+ *        The number of segments is the integral of 1 / size, rounded up, so that no
+ *        segment is longer than its size; it is then kept within the counts that the
+ *        size bounds allow. The field is scaled by the factor c that makes its integral
+ *        exactly that count, and kept within [floorSize, maxSize]: where the scaled size
+ *        would be below floorSize, the segments are floorSize long (min size wins).
+ */
+//================================================================================
+
+void AdaptiveAlgo::distribute( EdgeGrid& grid, double floorSize, bool isClosed,
+                               vector< double >& nodeU ) const
+{
+  const double maxSize = myHyp->GetMaxSize();
+  const size_t nbSteps = grid.myU.size() - 1;
+  const vector< double >& h = grid.myH;
+
+  double length = 0., hMin = maxSize, hMax = floorSize;
+  for ( size_t i = 0; i <= nbSteps; ++i )
+  {
+    length += grid.myDs[i];
+    hMin = Min( hMin, h[i] );
+    hMax = Max( hMax, h[i] );
+  }
+  auto sizeAt = [&]( double c, size_t i ) -> double
+  {
+    return Min( maxSize, Max( floorSize, c * h[i] ));
+  };
+  auto integral = [&]( double c ) -> double
+  {
+    double nb = 0.;
+    for ( size_t i = 1; i <= nbSteps; ++i )
+      nb += grid.myDs[i] * 0.5 * ( 1. / sizeAt( c, i-1 ) + 1. / sizeAt( c, i ));
+    return nb;
+  };
+
+  double nbSeg = ceil( integral( 1. ) - 1e-9 );
+  nbSeg = Min( nbSeg, floor( length / floorSize + 1e-9 ));
+  nbSeg = Max( nbSeg, ceil( length / maxSize - 1e-9 ));
+  nbSeg = Max( nbSeg, isClosed ? 3. : 1. );
+
+  // the integral decreases with c: from length / floorSize, all at floorSize, at
+  // cLo = floorSize / hMax, to length / maxSize, all at maxSize, at cHi = maxSize / hMin
+  double cLo = floorSize / hMax, cHi = maxSize / hMin;
+  for ( int it = 0; it < 200 && cHi - cLo > 1e-15 * cHi; ++it )
+  {
+    const double c = sqrt( cLo * cHi );
+    if ( integral( c ) > nbSeg )
+      cLo = c;
+    else
+      cHi = c;
+  }
+  const double c = sqrt( cLo * cHi );
+
+  grid.myF.resize( nbSteps + 1 );
+  vector< double > cumul( nbSteps + 1, 0. );
+  for ( size_t i = 0; i <= nbSteps; ++i )
+  {
+    grid.myF[i] = sizeAt( c, i );
+    if ( i > 0 )
+      cumul[i] = cumul[i-1] + grid.myDs[i] * 0.5 * ( 1. / grid.myF[i-1] + 1. / grid.myF[i] );
+  }
+  const int nb = int( nbSeg );
+  nodeU.resize( nb + 1 );
+  nodeU[0]  = grid.myU[0];
+  nodeU[nb] = grid.myU[ nbSteps ];
+  size_t i = 1;
+  for ( int k = 1; k < nb; ++k )
+  {
+    const double target = cumul[ nbSteps ] * k / nb;
+    while ( i < nbSteps && cumul[i] < target )
+      ++i;
+    const double r = ( target - cumul[i-1] ) / ( cumul[i] - cumul[i-1] );
+    nodeU[k] = grid.myU[i-1] + r * ( grid.myU[i] - grid.myU[i-1] );
+  }
+}
+
+//================================================================================
+/*!
+ * \brief pySMESH: hold the deflection on the segments of one EDGE.
+ *
+ * makeSegments() places the segments on a size field that the deflection only seeds;
+ * no segment is checked against the deflection. This checks each segment. If every
+ * segment meets the deflection, the parameters stay as they are. Otherwise the field
+ * is lowered over each segment that misses the deflection where the field is above its
+ * floor (the min size), graded, and the nodes are placed again, until every segment
+ * meets the deflection or lies where the field is at the floor (min size wins).
+ *  \param [in,out] eData - the EDGE; its probe sizes are lowered
+ *  \param [in,out] params - the parameters of the inner nodes
+ *  \retval bool - false if canceled or if the deflection is not met in theMaxIter steps
+ */
+//================================================================================
+
+bool AdaptiveAlgo::holdDeflection( EdgeData& eData, vector< double >& params )
+{
+  if ( eData.myC3d.GetType() == GeomAbs_Line )
+    return true;
+
+  const int    theMaxIter  = 200;
+  const double theMargin   = 0.9;  // aim below the deflection, and below the size there
+  const double theFloorTol = 1e-9; // relative: a size this close to the floor is the floor
+  const double deflection  = myHyp->GetDeflection();
+  const bool   isClosed    = SMESH_MesherHelper::IsClosedEdge( eData.Edge() );
+  // the min size as asked, but not below the smallest size the size tree keeps
+  const double minSize     = Max( myHyp->GetMinSize(), mySizeTree->GetMinSize() );
+  double floorSize = minSize;
+
+  vector< double > nodeU;
+  nodeU.push_back( eData.myC3d.FirstParameter() );
+  nodeU.insert( nodeU.end(), params.begin(), params.end() );
+  nodeU.push_back( eData.myC3d.LastParameter() );
+
+  // segments that miss the deflection; those where the field is above the floor can be
+  // shorter. Where the field is at the floor, min size wins.
+  vector< size_t > toFix;
+  vector< double > fixSize;
+  bool isMissed = false;
+  for ( size_t k = 0; k + 1 < nodeU.size(); ++k )
+  {
+    const double sag = segmentSagitta( eData.myC3d, nodeU[k], nodeU[k+1] );
+    if ( sag <= deflection )
+      continue;
+    isMissed = true;
+    const double fieldMax = probeFieldMax( eData, nodeU[k], nodeU[k+1] );
+    if ( fieldMax <= floorSize * ( 1. + theFloorTol ))
+      continue;
+    const double len = eData.myC3d.Value( nodeU[k] ).Distance( eData.myC3d.Value( nodeU[k+1] ));
+    toFix.push_back( k );
+    fixSize.push_back( Max( floorSize, theMargin * Min( len * sqrt( deflection / sag ), fieldMax )));
+  }
+  if ( !isMissed )
+    return true; // the segments of makeSegments() stay as they are
+
+  EdgeGrid grid;
+  for ( int iter = 0; ; ++iter )
+  {
+    if ( _computeCanceled )
+      return false;
+    if ( iter == theMaxIter )
+      return error( SMESH_Comment( "Adaptive1D: the deflection " ) << deflection
+                    << " is not met after " << theMaxIter << " refinements of EDGE #"
+                    << myMesh->GetMeshDS()->ShapeToIndex( eData.Edge() ));
+
+    for ( size_t j = 0; j < toFix.size(); ++j )
+      lowerProbeSize( eData, nodeU[ toFix[j] ], nodeU[ toFix[j] + 1 ], fixSize[j] );
+
+    // place the nodes; where an arc of the floor size gives a chord shorter than the
+    // min size, raise the floor by the shortfall
+    for ( int iFloor = 0; iFloor < 10; ++iFloor )
+    {
+      buildGrid( eData, floorSize, isClosed, grid );
+      distribute( grid, floorSize, isClosed, nodeU );
+      double minChord = 1e100;
+      for ( size_t k = 0; k + 1 < nodeU.size(); ++k )
+        minChord = Min( minChord,
+                        eData.myC3d.Value( nodeU[k] ).Distance( eData.myC3d.Value( nodeU[k+1] )));
+      if ( minChord >= minSize * ( 1. - 1e-12 ) || nodeU.size() <= 2 )
+        break;
+      floorSize *= minSize / minChord;
+    }
+
+    // check the new segments
+    toFix.clear();
+    fixSize.clear();
+    for ( size_t k = 0; k + 1 < nodeU.size(); ++k )
+    {
+      const double sag = segmentSagitta( eData.myC3d, nodeU[k], nodeU[k+1] );
+      if ( sag <= deflection )
+        continue;
+      const double hMax = grid.SpanMax( grid.myH, nodeU[k], nodeU[k+1] );
+      if ( hMax <= floorSize * ( 1. + theFloorTol ))
+        continue;
+      const double len = eData.myC3d.Value( nodeU[k] ).Distance( eData.myC3d.Value( nodeU[k+1] ));
+      toFix.push_back( k );
+      fixSize.push_back( Max( floorSize, theMargin * Min( len * sqrt( deflection / sag ), hMax )));
+    }
+    if ( toFix.empty() )
+      break;
+  }
+  params.assign( nodeU.begin() + 1, nodeU.end() - 1 );
+  return true;
+}
