 //================================================================================
 /*!
+ * \brief pySMESH: Return the ids of the nodes of the loaded grid
+ */
+//================================================================================
+
+vector<smIdType> _QuadFaceGrid::GetNodeIDs() const
+{
+  vector<smIdType> ids( myGrid.size() );
+  for ( size_t i = 0; i < myGrid.size(); ++i )
+    ids[ i ] = myGrid[ i ]->GetID();
+  return ids;
+}
+
+//================================================================================
+/*!
+ * \brief pySMESH: Replace the nodes of the loaded grid by their nodes in a proxy mesh
+ *  \param [in] proxyMesh - the proxy mesh of the viscous layers
+ *  \param [in] nodeIDs - the ids the grid nodes had before the layers were built
+ *  \return bool - false if a node of the grid is gone, so the grid no longer holds
+ *
+ *  The layers shrink the mesh of a side FACE without layers in place, and on a failed
+ *  smoothing they mesh it again, which removes its nodes. So each node is looked up by its
+ *  id: it must still be the same node.
+ */
+//================================================================================
+
+bool _QuadFaceGrid::MapToProxyNodes( const SMESH_ProxyMesh&   proxyMesh,
+                                     const vector<smIdType>& nodeIDs )
+{
+  if ( nodeIDs.size() != myGrid.size() )
+    return error(ERR_LI("Error in _QuadFaceGrid::MapToProxyNodes()"));
+  const SMESHDS_Mesh* meshDS = proxyMesh.GetMeshDS();
+  for ( size_t i = 0; i < myGrid.size(); ++i )
+  {
+    if ( meshDS->FindNode( nodeIDs[ i ] ) != myGrid[ i ] )
+      return error( "The viscous layers meshed a side FACE of the block again, "
+                    "so its grid of nodes no longer holds" );
+    myGrid[ i ] = proxyMesh.GetProxyNode( myGrid[ i ] );
+  }
+  return true;
+}
