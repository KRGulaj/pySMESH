+    // grade the larger of two neighbours that differ more than twice down to twice the
+    // smaller one; it never goes below the smaller one, so never below the min size
+    const size_t nbSeg = nodeU.size() - 1;
+    vector< double > segLen( nbSeg );
+    for ( size_t k = 0; k < nbSeg; ++k )
