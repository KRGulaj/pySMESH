 /*!
- * \brief pySMESH: hold the deflection on the segments of one EDGE.
+ * \brief pySMESH: whether the segments between the given nodes break a size bound
+ *        (min size, max size; relative tolerance 1e-9) or the factor 2 between two
+ *        neighbours of the EDGE, the two ends of a closed EDGE included
+ */
+//================================================================================
+
+bool AdaptiveAlgo::breaksBounds( const EdgeData& eData, const vector< double >& nodeU,
+                                 bool isClosed ) const
+{
+  const double theTol  = 1e-9;
+  const double minSize = myHyp->GetMinSize(), maxSize = myHyp->GetMaxSize();
+  vector< double > len( nodeU.size() - 1 );
+  for ( size_t k = 0; k < len.size(); ++k )
+  {
+    len[k] = eData.myC3d.Value( nodeU[k] ).Distance( eData.myC3d.Value( nodeU[k+1] ));
+    if ( len[k] < minSize * ( 1. - theTol ) || len[k] > maxSize * ( 1. + theTol ))
+      return true;
+  }
+  for ( size_t k = 0; k + 1 < len.size(); ++k )
+    if ( Max( len[k], len[k+1] ) > 2. * Min( len[k], len[k+1] ) * ( 1. + theTol ))
+      return true;
+  if ( isClosed && len.size() > 1 &&
+       Max( len[0], len.back() ) > 2. * Min( len[0], len.back() ) * ( 1. + theTol ))
+    return true;
+  return false;
+}
+
