+    const size_t nbPairs = ( isClosed && nbSeg > 1 ) ? nbSeg : nbSeg - 1;
+    for ( size_t k = 0; k < nbPairs; ++k )
+    {
+      const size_t k2 = ( k + 1 ) % nbSeg;
+      const size_t kBig   = ( segLen[k] > segLen[k2] ) ? k : k2;
+      const size_t kSmall = ( kBig == k ) ? k2 : k;
+      if ( segLen[ kBig ] <= 2. * segLen[ kSmall ] * ( 1. + 1e-9 ))
+        continue;
+      const double hMax = grid.SpanMax( grid.myH, nodeU[ kBig ], nodeU[ kBig + 1 ] );
+      if ( hMax <= floorSize * ( 1. + theFloorTol ))
+        continue;
+      toFix.push_back( kBig );
+      fixSize.push_back( Max( floorSize, theMargin * Min( 2. * segLen[ kSmall ], hMax )));
+    }
