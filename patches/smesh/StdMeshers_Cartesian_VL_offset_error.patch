+        "(BRepCheck_Analyzer): the layers are too thick for the shape, so that offset "
+        "surfaces cross. Use a smaller total thickness."
+        << workableThickness( theShape, theMesh.GetMeshDS(), _shapesWVL, -offset );
+      delete makeOffset;
+      return TopoDS_Shape();
+    }
     if ( makeOffset->IsDone() )
     {
       shrinkBodies.push_back( makeOffset->Shape() );
@@ -974,6 +1097,16 @@
