+
+  //================================================================================
+  /*!
+   * \brief pySMESH: whether the offset step works at a total thickness: every SOLID of
+   *        theShape, offset inward by it as MakeOffsetSolid does, is a non-empty solid that
+   *        BRepCheck_Analyzer finds valid, and the offset solids glue together. Throwaway
+   *        builders: the ViscousBuilder keeps nothing of it.
+   */
+  //================================================================================
+
+  bool offsetWorks( const TopoDS_Shape&    theShape,
+                    SMESHDS_Mesh*          theMeshDS,
+                    const std::set< int >& theShapesWVL,
+                    const double           theThickness )
+  {
+    TopTools_IndexedMapOfShape solids;
+    TopExp::MapShapes( theShape, TopAbs_SOLID, solids );
+    BOPAlgo_Builder glue;
+    glue.SetGlue( BOPAlgo_GlueFull );
+    for ( int i = 1; i <= solids.Size(); ++i )
+    {
+      BRepOffset_MakeOffset makeOffset;
+      makeOffset.Initialize( solids( i ), -theThickness, Precision::Confusion(),
+                             BRepOffset_Skin, /*Intersection=*/false, /*selfInter=*/false,
+                             GeomAbs_Intersection );
+      for ( TopExp_Explorer fEx( theShape, TopAbs_FACE ); fEx.More(); fEx.Next() )
+        if ( !theShapesWVL.count( theMeshDS->ShapeToIndex( fEx.Current() )))
+          makeOffset.SetOffsetOnFace( TopoDS::Face( fEx.Current() ), 0 );
+      makeOffset.MakeOffsetShape();
+      if ( !makeOffset.IsDone() || makeOffset.Shape().IsNull() ||
+           !BRepCheck_Analyzer( makeOffset.Shape() ).IsValid() )
+        return false;
+      glue.AddArgument( makeOffset.Shape() );
+    }
+    const TopAbs_ShapeEnum type = theShape.ShapeType();
+    if ( type == TopAbs_COMPOUND || type == TopAbs_COMPSOLID )
+    {
+      glue.Perform();
+      if ( glue.HasErrors() || glue.Shape().IsNull() )
+        return false;
+    }
+    return true;
+  }
+
+  //================================================================================
+  /*!
+   * \brief pySMESH: the sentence that names the largest total thickness for which the
+   *        offset step works, below theFailed: bisection with at most 12 offset steps.
+   *        Called on the failure path only. SMESH computes a failing SOLID twice in one
+   *        compute, so the last result is kept, holding the shape (so that no other shape
+   *        can take its place), and the second call makes no offset step.
+   */
+  //================================================================================
+
+  std::string workableThickness( const TopoDS_Shape&    theShape,
+                                 SMESHDS_Mesh*          theMeshDS,
+                                 const std::set< int >& theShapesWVL,
+                                 const double           theFailed )
+  {
+    struct LastBisection
+    {
+      TopoDS_Shape    shape;
+      double          thickness = 0.;
+      std::set< int > shapesWVL;
+      std::string     text;
+    };
+    static std::mutex    lastMutex;
+    static LastBisection last;
+    const std::lock_guard< std::mutex > lock( lastMutex );
+    if ( last.shape.IsSame( theShape ) && last.thickness == theFailed &&
+         last.shapesWVL == theShapesWVL )
+      return last.text;
+
+    const int maxOffsetSteps = 12;
+    double works = 0., fails = theFailed;
+    for ( int i = 0; i < maxOffsetSteps; ++i )
+    {
+      const double middle = 0.5 * ( works + fails );
+      if ( offsetWorks( theShape, theMeshDS, theShapesWVL, middle ))
+        works = middle;
+      else
+        fails = middle;
+    }
+    std::string text;
+    if ( works == 0. )
+      text = SMESH_Comment( " No total thickness above " ) << fails << " can be offset.";
+    else
+      text = SMESH_Comment( " The largest total thickness for which the offset works is about " )
+        << works << " (bisection of the offset step, to " << fails - works
+        << "): use a smaller one, with a margin, because near it the offset surfaces almost"
+        " meet.";
+    last = LastBisection{ theShape, theFailed, theShapesWVL, text };
+    return text;
+  }
+
 } // namespace
 
 
