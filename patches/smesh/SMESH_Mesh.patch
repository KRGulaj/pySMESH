looooo/SMESH patch/SMESH_Mesh.patch: build SMESH without MED (WITH_MED guards).
Re-ported to SALOME SMESH V9_16_0 by pySMESH. The '#undef _Precision_HeaderFile'
hunk is dropped: V9_16_0 comments it out itself (SMESH_Mesh.cxx:61). The guards are
extended to SMESH_DriverMesh.cxx, new in V9_16_0, which reads and writes MED files
through MEDCoupling; without MED each of its entry points throws SALOME_Exception.

diff --git a/src/SMESH/SMESH_DriverMesh.cxx b/src/SMESH/SMESH_DriverMesh.cxx
index bd95953..b459822 100644
--- a/src/SMESH/SMESH_DriverMesh.cxx
+++ b/src/SMESH/SMESH_DriverMesh.cxx
@@ -32,10 +32,16 @@
 #include "SMESH_Mesh.hxx"
 #include "SMESH_Gen.hxx"
 
+#ifdef WITH_MED
 #include <MEDFileMesh.hxx>
 #include <MEDCouplingUMesh.hxx>
 
 using namespace MEDCoupling;
+#else
+// Built without MED: every entry point below needs a MED file, so each one throws
+// instead of returning a result that was never computed.
+#include <Utils_SALOME_Exception.hxx>
+#endif
 
 /**
  * @brief Compares the mesh from two mesh files (MED)
@@ -47,19 +53,25 @@ using namespace MEDCoupling;
  * @return true if the mesh within the files are identical
  */
 bool SMESH_DriverMesh::diffMEDFile(const std::string mesh_file1, const std::string mesh_file2, const std::string mesh_name){
+#ifdef WITH_MED
   MEDFileUMesh* medmesh1 = MEDFileUMesh::New(mesh_file1, mesh_name);
   MEDFileUMesh* medmesh2 = MEDFileUMesh::New(mesh_file2, mesh_name);
   MEDCouplingUMesh *m0_1=medmesh1->getMeshAtLevel(0,false);
   MEDCouplingUMesh *m0_2=medmesh2->getMeshAtLevel(0,false);
   return m0_1->isEqual(m0_2, 1e-12);
+#else
+  throw SALOME_Exception( "SMESH_DriverMesh::diffMEDFile: built without MED support" );
+#endif
 }
 
+#ifdef WITH_MED
 std::string getMeshName(std::string mesh_file){
   // TODO: Memory leak but destructor private check with AG
   MEDFileUMesh * myMedMesh = MEDFileUMesh::New(mesh_file);
 
   return myMedMesh->getLevel0Mesh()->getName();
 }
+#endif
 
 /**
  * @brief Import a mesh from a mesh file (MED) into a SMESH_Mesh object
@@ -71,11 +83,15 @@ std::string getMeshName(std::string mesh_file){
  * @return error code
  */
 int SMESH_DriverMesh::importMesh(const std::string mesh_file, SMESH_Mesh& aMesh){
+#ifdef WITH_MED
   // TODO: change that as it depends on the language
   std::string mesh_name = getMeshName(mesh_file);
   MESSAGE("Importing mesh from " << mesh_file << " mesh " << mesh_name);
   int ret = aMesh.MEDToMesh(mesh_file.c_str(), mesh_name.c_str());
   return ret;
+#else
+  throw SALOME_Exception( "SMESH_DriverMesh::importMesh: built without MED support" );
+#endif
 }
 
