+++ b/src/StdMeshers/StdMeshers_Cartesian_3D.cxx
@@ -152,6 +152,8 @@
     TopoDS_Shape offsetShape = builder.MakeOffsetShape( theShape, theMesh, error );
     if ( offsetShape.IsNull() )
       throw SALOME_Exception( error );
+    if ( _computeCanceled ) // pySMESH: canceled during the offset step
+      return false;
 
     SMESH_Mesh* offsetMesh = new TmpMesh(); 
     offsetMesh->ShapeToMesh( offsetShape );
@@ -161,7 +163,7 @@
     if ( ! this->Compute( *offsetMesh, offsetShape ))
       return false;
 
-    return builder.MakeViscousLayers( *offsetMesh, theMesh, theShape );
+    return builder.MakeViscousLayers( *offsetMesh, theMesh, theShape, &_computeCanceled );
   }
 
   // The algorithm generates the mesh in following steps:
@@ -177,7 +179,10 @@
   // - add a hexahedron in the mesh, if all nodes are inside
   // - add a polyhedron in the mesh, if some nodes are inside and some outside
 
-  _computeCanceled = false;
+  // pySMESH: the inner call of the viscous layers path keeps a cancel that came
+  // during the offset step; the flag was reset before the outer call
+  if ( !_isComputeOffset )
+    _computeCanceled = false;
 
   SMESH_MesherHelper helper( theMesh );
   SMESHDS_Mesh* meshDS = theMesh.GetMeshDS();
