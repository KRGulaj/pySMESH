"""Build-time dependency versions and provenance (generated by CMake, do not edit).

Every value here is provenance only. Nothing in this module is enforced at import time.

Before 4.0.0, ``VTK_VERSION`` was checked against the host environment's VTK, because
``_core`` resolved VTK from that environment. Since 4.0.0 the VTK DLLs are bundled into the
wheel and name-mangled alongside OCCT and Boost, so there is no host VTK to agree with and
no version for a consumer to track. The value is retained to answer "what was this binary
built against", which matters when reproducing a build or reading a bug report.
"""

from __future__ import annotations

from typing import Final

VTK_VERSION: Final[str] = "@PYSMESH_VTK_VERSION@"
OCCT_VERSION: Final[str] = "@PYSMESH_OCCT_VERSION@"
BOOST_VERSION: Final[str] = "@PYSMESH_BOOST_VERSION@"
GIT_SHA: Final[str] = "@PYSMESH_GIT_SHA@"
BUILD_DATE: Final[str] = "@PYSMESH_BUILD_DATE@"
WITH_NETGEN: Final[bool] = @PYSMESH_WITH_NETGEN@
